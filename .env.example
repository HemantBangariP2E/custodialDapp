# Optional unified ks-wallet-be base (no trailing slash). Used when the specific vars below are unset.
# In `npm run dev`, leaving these unset uses Vite proxy → http://localhost:3005 (same-origin).
# To call the API host directly from the browser (cross-origin), use e.g.:
# VITE_API_BASE_URL=http://localhost:3005

# Explicit alpha-style host (overrides VITE_API_BASE_URL for those routes only)
# VITE_CREATE_WALLET_BASE_URL=https://alpha-wallet-api.kalp.studio

# /relayer/write-transaction only (defaults to wallet-api in production; dev uses proxy when unset)
# VITE_RELAYER_WRITE_BASE_URL=https://wallet-api.kalp.studio

# Arena multiplayer WebSocket
# - Local dev: auto ws://127.0.0.1:5181 when you run `npm run dev` (or `npm run arena-server`)
# - Netlify/production: deploy server/arena-ws.mjs (Railway, Render, Fly), then set wss URL here and REDEPLOY
# VITE_ARENA_WS_URL=wss://your-arena-server.example.com
# VITE_ARENA_WS_URL=ws://127.0.0.1:5181
# Set VITE_ARENA_WS_EXTERNAL=1 if you run arena-server yourself and vite should not spawn it
